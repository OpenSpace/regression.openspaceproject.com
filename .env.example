# Server Configuration
PORT=8000

# Admin Token (required). Used to update reference images and the difference threshold.
# The server refuses to start while it is empty, so set it to a long, random value
ADMIN_TOKEN=

# Slack Integration (optional - for error notifications)
SLACK_TOKEN=
SLACK_CHANNEL=

# CORS Configuration (optional, comma-separated list of allowed origins). The frontend is
# served by the same server, so this is only needed for other websites that use the API
# CORS_ORIGINS=https://example.com,http://localhost:5173

# Rate limiting (optional - defaults shown). Failed authentication attempts are limited to
# 10 per window and the comparison API to RATE_LIMIT_MAX_REQUESTS per window
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=120
