# Server Configuration
PORT=8000
DATA_DIR=data

# Admin Token (required for updating reference images)
ADMIN_TOKEN=your-admin-token-here

# Slack Integration (optional - for error notifications)
SLACK_TOKEN=your-slack-bot-token
SLACK_CHANNEL=your-slack-channel-id

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=https://regression.openspaceproject.com,http://localhost:5173

# Image Comparison Threshold (0.0 to 1.0)
COMPARISON_THRESHOLD=0.1

# Image Size (width, height)
IMAGE_WIDTH=1920
IMAGE_HEIGHT=1080

# Thumbnail Scale Factor
THUMBNAIL_SCALE=6

# Rate Limiting (optional - defaults shown)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100