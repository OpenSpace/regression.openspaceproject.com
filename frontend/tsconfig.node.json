{
  // The shared configuration is installed in the node_modules folder of the backend
  "extends": "@openspace/shared-configs/tsconfig.json",

  "compilerOptions": {
    // The Vite configuration is loaded by Vite, which bundles it
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
