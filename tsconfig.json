{
  "extends": "@openspace/shared-configs/tsconfig.json",

  "compilerOptions": {
    "outDir": "out",
    "rootDir": "src",

    // The backend is compiled to CommonJS, which uses `require` instead of `import`
    "verbatimModuleSyntax": false,

    "noEmitOnError": true,
    "removeComments": true,
    "sourceMap": true
  },
  "files": ["src/main.ts"]
}
